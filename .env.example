# 슬랙 설정 (필수)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#trading-signals

# 한국투자증권 REST API (선택, 외국인 수급 데이터)
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_ACCOUNT_NO=your_account_number
KIS_IS_REAL=false   # true=실거래, false=모의투자

# DART 전자공시 API (선택, 자사주 공시 확인)
DART_API_KEY=your_dart_api_key

# 예산 설정
TOTAL_BUDGET=100000       # 총 투자 예산 (원)
MAX_POSITIONS=3           # 최대 동시 보유 종목 수

# 스케줄러
SCAN_INTERVAL_MINUTES=5   # 스캔 주기 (분)
